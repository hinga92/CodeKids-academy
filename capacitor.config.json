{
  "appId": "com.karanja.codekids",
  "appName": "CodeKids Academy",
  "webDir": "www",
  "backgroundColor": "#07090f",
  "ios": {
    "contentInset": "never",
    "scheme": "CodeKids"
  },
  "android": {
    "allowMixedContent": false
  },
  "plugins": {
    "SplashScreen": {
      "launchAutoHide": true,
      "launchShowDuration": 3000,
      "backgroundColor": "#07090f",
      "showSpinner": false
    },
    "LocalNotifications": {
      "iconColor": "#00d4aa"
    }
  }
}